<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Dashboard - URL Shortener</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="bg-slate-100 min-h-screen">


    <%- include("partials/navbar") %>


    <main class="max-w-6xl mx-auto px-6 py-10">


        <!-- Header -->

        <div class="mb-8">

            <h1 class="text-3xl font-bold text-slate-800">
                Dashboard
            </h1>

            <p class="text-slate-500 mt-1">
                Create and manage your shortened URLs.
            </p>

        </div>


        <!-- Create URL -->

        <div class="bg-white rounded-2xl shadow p-6 mb-8">


            <h2 class="text-xl font-bold text-slate-800 mb-5">
                Shorten a URL
            </h2>


            <% if (error) { %>

                <div class="bg-red-100 text-red-700 p-3 rounded-lg mb-5">
                    <%= error %>
                </div>

            <% } %>


            <% if (success) { %>

                <div class="bg-green-100 text-green-700 p-3 rounded-lg mb-5">
                    <%= success %>
                </div>

            <% } %>


            <form
                action="/shorten"
                method="POST"
                class="space-y-4"
            >


                <div>

                    <label class="block text-sm font-medium mb-2">
                        Original URL
                    </label>

                    <input
                        type="url"
                        name="originalUrl"
                        placeholder="https://example.com/very/long/url"
                        required
                        class="w-full border border-slate-300 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500"
                    >

                </div>


                <div>

                    <label class="block text-sm font-medium mb-2">
                        Custom Short Code
                        <span class="text-slate-400">
                            (optional)
                        </span>
                    </label>

                    <input
                        type="text"
                        name="customCode"
                        placeholder="my-link"
                        class="w-full border border-slate-300 rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500"
                    >

                </div>


                <button
                    type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition"
                >
                    Shorten URL
                </button>


            </form>


        </div>


        <!-- URL List -->

        <div class="bg-white rounded-2xl shadow overflow-hidden">


            <div class="p-6 border-b">

                <h2 class="text-xl font-bold text-slate-800">
                    My URLs
                </h2>

                <p class="text-slate-500 text-sm mt-1">
                    URLs created by you
                </p>

            </div>


            <% if (urls.length === 0) { %>

                <div class="p-10 text-center">

                    <p class="text-slate-500">
                        You haven't shortened any URL yet.
                    </p>

                </div>

            <% } else { %>


                <div class="overflow-x-auto">

                    <table class="w-full">


                        <thead class="bg-slate-50">

                            <tr>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-600">
                                    Original URL
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-600">
                                    Short URL
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-600">
                                    Clicks
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-600">
                                    Created
                                </th>

                            </tr>

                        </thead>


                        <tbody class="divide-y">


                            <% urls.forEach(url => { %>


                                <tr class="hover:bg-slate-50">


                                    <td class="px-6 py-4 max-w-xs">

                                        <a
                                            href="<%= url.originalUrl %>"
                                            target="_blank"
                                            class="text-blue-600 hover:underline truncate block"
                                        >
                                            <%= url.originalUrl %>
                                        </a>

                                    </td>


                                    <td class="px-6 py-4">

                                        <a
                                            href="/<%= url.shortCode %>"
                                            target="_blank"
                                            class="text-blue-600 font-semibold hover:underline"
                                        >
                                            /<%= url.shortCode %>
                                        </a>

                                    </td>


                                    <td class="px-6 py-4">

                                        <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-sm font-medium">
                                            <%= url.clicks %>
                                        </span>

                                    </td>


                                    <td class="px-6 py-4 text-slate-500 text-sm">

                                        <%= new Date(url.createdAt).toLocaleDateString() %>

                                    </td>


                                </tr>


                            <% }) %>


                        </tbody>


                    </table>

                </div>


            <% } %>


        </div>


    </main>


</body>

</html>